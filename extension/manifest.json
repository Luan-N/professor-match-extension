{
  "manifest_version": 3,
  "name": "Professor Match",
  "version": "0.1.0",
  "description": "Personalized professor information and review analysis.",
  "permissions": [
    "storage",
    "activeTab"

  ],
  "host_permissions": [
    "https://www.ratemyprofessors.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Professor Match",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
